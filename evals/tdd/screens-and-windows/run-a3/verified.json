  "domain.ts": "export type Stop={id:string;position:number;removed?:boolean;startedOn?:string;status:'NEW'|'IN_PROGRESS'|'POSTPONED'|'DONE'};\nexport const requiresReason=(stop:Stop)=>Boolean(stop.startedOn)&&stop.status!=='DONE';\n",
  "logic.ts": "import type {Stop} from './domain';\n\n/** Return the server's 1-based rank among active stops. */\nexport function moveUp(stops:Stop[],activeIndex:number){\n  const active=stops.filter(s=>!s.removed).sort((a,b)=>a.position-b.position);\n  const current=active.findIndex(s=>s.id===stops[activeIndex]?.id);\n  if(current<=0)return undefined;\n  return {id:active[current].id,position:current};\n}\n\nexport function moveDown(stops:Stop[],activeIndex:number){\n  const active=stops.filter(s=>!s.removed).sort((a,b)=>a.position-b.position);\n  const current=active.findIndex(s=>s.id===stops[activeIndex]?.id);\n  if(current<0||current>=active.length-1)return undefined;\n  return {id:active[current].id,position:current+2};\n}\n\nexport const screenRequiresReason=(stop:Stop)=>Boolean(stop.startedOn)&&stop.status!=='DONE';\n\nexport function fitsWindow(at:number,notice:{sentAt:number},appointments:{at:number;status:string}[],now:number){\n  if(!Number.isFinite(at)||at<now||at<notice.sentAt)return false;\n  const next=appointments.filter(a=>a.status!=='CANCELLED'&&a.status!=='HELD'&&a.at>now).sort((a,b)=>a.at-b.at)[0];\n  return !next||at<next.at;\n}\n\nexport const validateSchedule=(at:number,notice:{sentAt:number},appointments:{at:number;status:string}[],now:number)=>fitsWindow(at,notice,appointments,now);\n",
  "package.json": "{\"private\": true, \"type\": \"module\", \"scripts\": {\"test\": \"bun test\"}, \"dependencies\": {\"react\": \"19.2.0\", \"react-dom\": \"19.2.0\", \"jsdom\": \"27.1.0\"}}",
  "smoke.test.ts": "import {test,expect} from 'bun:test';import {fitsWindow} from './logic';test('ordinary slot',()=>expect(fitsWindow(15,{sentAt:10},[{at:20,status:'PLANNED'}],10)).toBe(true));\n"
}
