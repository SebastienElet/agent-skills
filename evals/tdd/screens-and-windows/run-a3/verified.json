{
  "AGENTS.md": "Implement the user request autonomously. Use the repository contracts and existing tools. Do not ask questions or commit. This is a synthetic isolated experiment. Local Docker and loopback services are authorized; DOCKER_HOST selects the dedicated daemon. Never override its host or context. Use login:false for shell commands so the supplied PATH persists. Do not contact other external services.\n",
  "PlanningScreen.tsx": "import React,{useState} from 'react';\nimport type {Stop} from './domain';\nimport {screenRequiresReason,moveUp,moveDown,fitsWindow} from './logic';\n\ntype Proposal={title:string;fileId:string};\ntype Appointment={at:number;status:string};\ntype Props={storeId:string;proposal?:Proposal;onSubmit:(data:unknown)=>void;stops?:Stop[];onReorder?:(data:{id:string;position:number})=>void;notice?:{sentAt:number};appointments?:Appointment[];now?:number;onSchedule?:(at:number)=>void};\n\nexport function PlanningScreen(props:Props){\n  const {storeId,proposal,onSubmit,stops=[],onReorder,notice,appointments=[],now=Date.now(),onSchedule}=props;\n  const [reason,setReason]=useState<Record<string,string>>({});\n  const [schedule,setSchedule]=useState('');\n  const [scheduleError,setScheduleError]=useState('');\n  const ordered=stops.filter(s=>!s.removed).slice().sort((a,b)=>a.position-b.position);\n  return <main>\n    {ordered.length>0&&<section aria-label=\"Delivery stops\"><h2>Delivery stops</h2><ol>{ordered.map((stop,index)=>{\n      const request=moveUp(stops,stops.findIndex(s=>s.id===stop.id));\n      const down=moveDown(stops,stops.findIndex(s=>s.id===stop.id));\n      return <li key={stop.id}>{stop.id} <span>{stop.status}</span>{index>0&&<button type=\"button\" aria-label={`Move ${stop.id} up`} onClick={()=>request&&onReorder?.(request)}>Move up</button>}{index<ordered.length-1&&<button type=\"button\" aria-label={`Move ${stop.id} down`} onClick={()=>down&&onReorder?.(down)}>Move down</button>}\n        {screenRequiresReason(stop)&&<label>Reason for {stop.id}<input aria-label={`Reason for ${stop.id}`} value={reason[stop.id]||''} onChange={e=>setReason({...reason,[stop.id]:e.target.value})}/></label>}\n      </li>;\n    })}</ol></section>}\n    {notice&&<form onSubmit={e=>{e.preventDefault();const at=new Date(schedule).getTime();if(!fitsWindow(at,notice,appointments,now)){setScheduleError('Choose a time after the notification and before the next appointment.');return;}setScheduleError('');onSchedule?.(at);}}>\n      <label>Schedule delivery<input aria-label=\"Schedule delivery\" type=\"datetime-local\" value={schedule} onChange={e=>setSchedule(e.target.value)}/></label>\n      {scheduleError&&<p role=\"alert\">{scheduleError}</p>}<button type=\"submit\">Schedule</button>\n    </form>}\n    <ProposalForm key={storeId} storeId={storeId} proposal={proposal} onSubmit={onSubmit}/>\n  </main>;\n}\n\nfunction ProposalForm({storeId,proposal,onSubmit}:{storeId:string;proposal?:Proposal;onSubmit:(data:unknown)=>void}){\n  const [form,setForm]=useState<Proposal>({title:'',fileId:''});\n  return <form onSubmit={e=>{e.preventDefault();onSubmit({storeId,...form});}}>\n    <label>Title<input aria-label=\"Title\" value={form.title} onChange={e=>setForm({...form,title:e.target.value})}/></label>\n    {form.fileId&&<span>Upload attached</span>}\n    <button type=\"button\" onClick={()=>proposal&&setForm({...proposal})} disabled={!proposal}>Use upload</button>\n    <button type=\"submit\">Save</button>\n  </form>;\n}\n",
  "README.md": "# Shop web\nThe server accepts a 1-based destination rank among active stops. Removed stops leave stored-position gaps.\nA started stop requires a reason unless it is done. The server's domain predicate is canonical.\nA scheduling slot belongs in [notification.sentAt, next upcoming appointment.at); held and cancelled appointments are excluded.\nA dropped proposal belongs to its selected store. Switching stores must not submit the previous store's file.\nRun `bun test`. Time is supplied explicitly to scheduling logic.\n",
