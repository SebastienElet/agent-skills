{
  "name": "@sebastienelet/agent-skills",
  "version": "0.0.1",
  "description": "Reusable agent workflows with their references, resources and evaluations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SebastienElet/agent-skills.git"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "files": [
    "skills/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "output-discipline-hook": "skills/output-discipline/scripts/output-discipline-hook.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml,ts}\" .github"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
